PORT=4000

# Backblaze B2 application key (create one at https://secure.backblaze.com/app_keys.htm)
# Minimum capabilities needed for now: listBuckets, listFiles
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# KPI thresholds (in days since last backup)
KPI_WARNING_DAYS=2
KPI_CRITICAL_DAYS=7

# How long bucket stats are cached in memory before being refetched from B2 (ms)
CACHE_TTL_MS=300000
